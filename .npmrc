# NPM Configuration for tyse-scrutiny-gateway

# Puppeteer configuration
# Skip Chromium download to prevent installation hangs
# Puppeteer 9.1.1 has issues downloading Chromium on some systems
PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true

# Use legacy peer dependencies resolution
# Required for compatibility with JHipster 8.11.0 dependencies
legacy-peer-deps=true
