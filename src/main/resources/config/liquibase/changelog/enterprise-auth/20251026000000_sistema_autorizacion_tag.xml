<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        Sistema de Autorización Empresarial - Tag de Snapshot

        Este tag marca el estado completo del sistema de autorización después de:
        - Creación de todas las tablas (scr_authority, scr_permission, etc.)
        - Carga de datos semilla (roles ADMIN y USER, permisos base)
        - Configuración de foreign keys y constraints

        Uso para rollback:
        ./mvnw liquibase:rollback -Dliquibase.rollbackTag=sistema-autorizacion

        Author: Tyse Scrutiny Team
        Date: 2025-10-26
    -->

    <changeSet id="20251026000000-tag-sistema-autorizacion" author="Manuel A. Motta H.">
        <tagDatabase tag="sistema-autorizacion"/>
    </changeSet>

</databaseChangeLog>
