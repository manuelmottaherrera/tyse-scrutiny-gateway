#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

################################################################################
# Pre-push Hook
#
# Este hook ejecuta el CI local completo (con E2E) antes de permitir push a main/develop
# Solo permite el push si todos los tests pasan exitosamente.
################################################################################

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Get the current branch name
current_branch=$(git symbolic-ref --short HEAD 2>/dev/null)

# Check if pushing to main or develop
if [ "$current_branch" = "main" ] || [ "$current_branch" = "develop" ]; then
    echo ""
    echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "${YELLOW}⚠️  Pre-push validation for branch: ${current_branch}${NC}"
    echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo ""
    echo -e "${YELLOW}Running COMPLETE CI pipeline (with E2E) before push...${NC}"
    echo -e "This ensures your code will pass GitHub Actions CI."
    echo -e "${YELLOW}⏱️  This may take 20-25 minutes.${NC}"
    echo ""

    # Run the CI script WITH E2E tests (complete validation)
    if ./scripts/ci-local.sh --with-e2e; then
        echo ""
        echo -e "${GREEN}✅ Pre-push validation passed!${NC}"
        echo -e "${GREEN}Proceeding with push to ${current_branch}...${NC}"
        echo ""
        exit 0
    else
        echo ""
        echo -e "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
        echo -e "${RED}❌ Pre-push validation failed!${NC}"
        echo -e "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
        echo ""
        echo -e "${YELLOW}Your code did not pass the CI checks.${NC}"
        echo -e "${YELLOW}Please fix the errors before pushing to ${current_branch}.${NC}"
        echo ""
        echo -e "Options:"
        echo -e "  1. Fix the failing tests"
        echo -e "  2. Run ${BLUE}./scripts/ci-local.sh --with-e2e${NC} to debug locally"
        echo -e "  3. Use ${BLUE}git push --no-verify${NC} to skip this check (not recommended)"
        echo ""
        exit 1
    fi
else
    echo ""
    echo -e "${BLUE}ℹ️  Pushing to branch: ${current_branch}${NC}"
    echo -e "${BLUE}Pre-push CI validation is only enforced for main/develop${NC}"
    echo ""
fi
