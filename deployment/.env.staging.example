# ===================================================================
# Tyse Scrutiny - Staging Environment Configuration
#
# Copy this file to .env.staging and fill in the actual values
# ===================================================================

# Docker Registry
REGISTRY=ghcr.io
GATEWAY_IMAGE=manuelmottaherrera/tyse-scrutiny-gateway
DIVIPOL_IMAGE=manuelmottaherrera/tyse-scrutiny-micro-divipol

# Image Tags
IMAGE_TAG_GATEWAY=develop
IMAGE_TAG_DIVIPOL=develop

# Service Ports
GATEWAY_PORT=8090
DIVIPOL_PORT=8091
CONSUL_PORT=8510
KAFKA_PORT=9102

# MailHog Configuration (Email Testing for Staging)
MAILHOG_SMTP_PORT=1035
MAILHOG_UI_PORT=8035

# Database Configuration (External PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_PORT_DIVIPOL=5433

# Gateway Database
GATEWAY_DB_NAME=tyse_scrutiny_gateway_staging
GATEWAY_DB_USER=tyse_gateway
GATEWAY_DB_PASSWORD=CHANGE_ME

# Divipol Database
DIVIPOL_DB_NAME=tyse_scrutiny_divipol_staging
DIVIPOL_DB_USER=tyse_divipol
DIVIPOL_DB_PASSWORD=CHANGE_ME

# JWT Secret (REQUIRED - generate with: openssl rand -base64 64)
JWT_SECRET=CHANGE_ME

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://example:8090,http://ip:8090

# Google reCAPTCHA Configuration (REQUIRED)
# Get your keys from: https://www.google.com/recaptcha/admin
# Site key (public, used in frontend)
GOOGLE_RECAPTCHA_SITE_KEY=CHANGE_ME
# Secret key (private, used in backend verification)
GOOGLE_RECAPTCHA_SECRET_KEY=CHANGE_ME
