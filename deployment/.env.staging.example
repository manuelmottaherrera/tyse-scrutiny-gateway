################################################################################
# Tyse Scrutiny - Staging Environment Configuration
#
# IMPORTANT: Copy this file to .env.staging and fill in your actual values
#            DO NOT commit .env.staging to version control
#
# Usage: cp .env.staging.example .env.staging
################################################################################

# =============================================================================
# DOCKER IMAGE CONFIGURATION
# =============================================================================
# GitHub Container Registry configuration
# NOTE: Gateway and Divipol are SEPARATE repositories
REGISTRY=ghcr.io
GATEWAY_IMAGE=manuelmottaherrera/tyse-scrutiny-gateway
DIVIPOL_IMAGE=manuelmottaherrera/tyse-scrutiny-micro-divipol

# Image tags (can be different for each service)
IMAGE_TAG_GATEWAY=develop
IMAGE_TAG_DIVIPOL=develop

# =============================================================================
# SERVICE PORTS (Customize to avoid conflicts with other apps)
# =============================================================================
# External ports (accessible from host)
GATEWAY_PORT=8090
DIVIPOL_PORT=8091
CONSUL_PORT=8510
KAFKA_PORT=9102

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# Database server (can be different server or localhost)
DB_HOST=your-database-server-ip
# Example: DB_HOST=192.168.1.100

# Gateway Database Configuration
DB_PORT=5432
GATEWAY_DB_NAME=tysescrutinygateway
GATEWAY_DB_USER=tysescrutinygateway
GATEWAY_DB_PASSWORD=your-secure-password-here

# Divipol Microservice Database Configuration
DB_PORT_DIVIPOL=5433
DIVIPOL_DB_NAME=tysescrutinymicrodivipol
DIVIPOL_DB_USER=tysescrutinymicrodivipol
DIVIPOL_DB_PASSWORD=your-secure-password-here

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
# JWT Secret - MUST be the same across all services
# Generate a secure secret:
#   openssl rand -base64 64 | tr -d '\n'
JWT_SECRET=your-jwt-secret-base64-encoded-minimum-512-bits

# CORS Configuration
# Comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:8090,https://your-domain.com

# =============================================================================
# OPTIONAL: ADVANCED CONFIGURATION
# =============================================================================

# JHipster Sleep (seconds to wait before starting - gives time for dependencies)
JHIPSTER_SLEEP=30

# Logging Levels (DEBUG, INFO, WARN, ERROR)
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_TYSE=DEBUG

# =============================================================================
# DEPLOYMENT NOTES
# =============================================================================
# 1. Ensure PostgreSQL databases exist on the database server:
#    - Create databases: tysescrutinygateway, tysescrutinymicrodivipol
#    - Create users with appropriate permissions
#    - Configure PostgreSQL to accept connections from application server
#
# 2. Generate a strong JWT secret:
#    openssl rand -base64 64 | tr -d '\n'
#
# 3. Verify port availability on host:
#    sudo netstat -tuln | grep -E '8090|8091|8510|9102'
#
# 4. If ports are in use, change them above to available ports
#
# 5. After configuration, verify with:
#    docker compose -f docker-compose.staging.yml --env-file .env.staging config
# =============================================================================
